{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "proxy": {
    "entrypoint": "proxy.ts",
    "matcher": "/api/:path*"
  },
  "functions": {
    "proxy.ts": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}