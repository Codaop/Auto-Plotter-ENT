# Frontend proxy target; keep the /api path out because proxy.ts forwards it.
API_URL=http://localhost:8001
DISABLE_HOT_RELOAD=false
DISABLE_VISUAL_EDITS=false
DISABLE_EMERGENT_OVERLAY=false
CHOKIDAR_USEPOLLING=true

# Backend
APP_TZ=UTC
EMERGENT_LLM_KEY=your_gemini_api_key_here
CORS_ORIGINS=*
BACKEND_URL=http://localhost:8001